# ── Firebase Web SDK ──────────────────────────────────────────────
# Isi nilai dari Firebase Console → Project settings → Your apps.
# Selama nilai ini kosong, E-Cash berjalan dalam Mode Demo (localStorage).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Opsional — Analytics hanya dimuat pada build produksi bila diisi.
VITE_FIREBASE_MEASUREMENT_ID=

# ── Express API (opsional) ────────────────────────────────────────
PORT=8787
# Path absolut/relatif ke service account JSON untuk Firebase Admin.
# Kosongkan jika tidak memakai API server-side.
FIREBASE_SERVICE_ACCOUNT=
